{
  "name": "fibonacci-adaptive",
  "repeats": 10,
  "scheduler": {
    "workers": 8,
    "initialMode": "STATIC_ROUND_ROBIN",
    "adaptive": true,
    "queueCapacity": 1024,
    "stealWaitNanos": 10000,
    "seed": 42,
    "thresholds": {
      "sampleIntervalMillis": 5,
      "consecutiveSamples": 3,
      "imbalanceEnter": 2.0,
      "imbalanceExit": 1.3,
      "stealSuccessLow": 0.2,
      "idleRatioHigh": 0.25
    }
  },
  "workload": {
    "type": "fibonacci",
    "n": 25,
    "nodeMicros": 5
  }
}
